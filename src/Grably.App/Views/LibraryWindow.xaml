<ui:FluentWindow
    x:Class="Grably.App.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Grably.App.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
    Title="Grably"
    Width="1120"
    Height="760"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/Assets/grably.ico">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Grably">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/grably-app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header: title, search and filters on the left, actions on the right -->
        <Grid Grid.Row="1" Margin="24,4,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="Library"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <StackPanel Grid.Column="1" Margin="24,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox
                    x:Name="SearchBox"
                    Width="260"
                    PlaceholderText="Search titles, apps and text"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel x:Name="FilterButtons" Margin="12,0,0,0" Orientation="Horizontal" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="Capture" Icon="{ui:SymbolIcon Screenshot24}" Command="{Binding CaptureRegionCommand}" />
                <ui:Button Margin="0,0,8,0" Content="Record" Icon="{ui:SymbolIcon Record24}" Command="{Binding RecordCommand}" />
                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <!-- Items whose files were moved or deleted outside Grably -->
            <Border
                Margin="24,0,24,12"
                Padding="12,8"
                CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding MissingCount, Converter={x:Static vm:Converters.PositiveToVisible}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Remove from library" Command="{Binding RemoveMissingCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding MissingText}" />
                </DockPanel>
            </Border>
            <TextBlock
                Margin="28,0,24,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding TruncatedText}"
                Visibility="{Binding IsTruncated, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- The grid of captures -->
        <ListBox
            x:Name="ItemsList"
            Grid.Row="3"
            Margin="16,0,16,8"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            ItemsSource="{Binding Items}"
            SelectionMode="Extended"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            MouseDoubleClick="ItemsList_MouseDoubleClick"
            PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
            PreviewMouseMove="ItemsList_PreviewMouseMove"
            KeyDown="ItemsList_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel ItemSize="252,226" SpacingMode="Uniform" StretchItems="False" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" InputGestureText="Enter" Click="Open_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Edit24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy image" InputGestureText="Ctrl+C" Click="CopyImage_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy path" Click="CopyPath_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentCopy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Show in folder" Click="ShowInFolder_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Rename24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
                    <StackPanel>
                        <Border Height="150" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border
                                    Margin="6"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Missing" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Border>
                                <Border
                                    Margin="6"
                                    Padding="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="4"
                                    Background="#99000000"
                                    ToolTip="Annotations can still be edited"
                                    Visibility="{Binding IsEditable, Converter={StaticResource Visible}}">
                                    <ui:SymbolIcon Symbol="Edit16" FontSize="12" Foreground="White" />
                                </Border>
                                <!-- Recordings and GIFs: a play mark with the length, or GIF -->
                                <Border
                                    Margin="6"
                                    Padding="5,2,7,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="4"
                                    Background="#99000000"
                                    Visibility="{Binding VideoBadge, Converter={x:Static vm:Converters.NotNullToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play16" Filled="True" FontSize="11" Foreground="White" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding VideoBadge}" FontSize="11" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Margin="2,8,2,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Margin="2,2,2,0" Text="{Binding Details}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Nothing captured yet -->
        <StackPanel
            Grid.Row="3"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLibraryEmpty, Converter={StaticResource Visible}}">
            <Image Width="96" Height="96" Margin="0,0,0,20" Source="pack://application:,,,/Assets/grably-app-icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock HorizontalAlignment="Center" Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- A search or filter matched nothing -->
        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Nothing matches. Try other words or another filter."
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Visibility="{Binding HasNoResults, Converter={StaticResource Visible}}" />
    </Grid>
</ui:FluentWindow>
