<ui:FluentWindow
    x:Class="Grably.App.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Grably.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
    Title="Grably"
    Width="1080"
    Height="720"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/Assets/grably.ico">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Grably">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/grably-app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header: page title and the main actions -->
        <Grid Grid.Row="1" Margin="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="Library"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Text="Your screenshots and recordings"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Content="Capture"
                    Icon="{ui:SymbolIcon Screenshot24}"
                    Command="{Binding CaptureRegionCommand}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Content="Record"
                    Icon="{ui:SymbolIcon Record24}"
                    Command="{Binding RecordCommand}" />
                <ui:Button
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Settings24}"
                    ToolTip="Settings"
                    Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- Content: the capture grid arrives in M4; until then, the empty state -->
        <Border
            Grid.Row="2"
            Margin="24,0,24,24"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image
                    Width="96"
                    Height="96"
                    Margin="0,0,0,20"
                    Source="pack://application:,,,/Assets/grably-app-icon.png"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding EmptyTitle}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding EmptyHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
