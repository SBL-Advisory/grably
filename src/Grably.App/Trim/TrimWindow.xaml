<ui:FluentWindow
    x:Class="Grably.App.Trim.TrimWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Grably.App.Trim"
    Title="Grably trim"
    Width="1180"
    Height="780"
    MinWidth="760"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/Assets/grably.ico">

    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="Grably trim">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/grably-app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Edits on the left, the frame on the right -->
        <DockPanel Grid.Row="1" Margin="12,0,12,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button x:Name="UndoButton" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="Undo (Ctrl+Z)" IsEnabled="False" Click="Undo_Click" />
                <ui:Button x:Name="RedoButton" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="Redo (Ctrl+Y)" IsEnabled="False" Click="Redo_Click" />
                <Separator Margin="6,4" />
                <ui:Button x:Name="CutButton" Appearance="Transparent" Icon="{ui:SymbolIcon Cut24}" Content="Cut out selection" ToolTip="Remove the selected part (Delete)" IsEnabled="False" Click="Cut_Click" />
                <ui:Button x:Name="KeepButton" Appearance="Transparent" Icon="{ui:SymbolIcon CropInterim24}" Content="Keep only selection" ToolTip="Trim both ends to the selection (K)" IsEnabled="False" Margin="4,0,0,0" Click="Keep_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="SaveFrameButton" Appearance="Transparent" Icon="{ui:SymbolIcon ImageEdit24}" Content="Edit this frame" ToolTip="Open the frame on screen in the image editor (Ctrl+E)" IsEnabled="False" Click="SaveFrame_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Playback through MediaElement; the exact frame from ffmpeg on top whenever playback is paused -->
            <Border x:Name="PreviewHost" Background="Black" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="False" Stretch="Uniform"
                                  MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed" MediaEnded="Media_MediaEnded" />
                    <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PreviewMessage" Foreground="White" Opacity="0.8" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Text="Opening the video..." />
                </Grid>
            </Border>

            <!-- Export -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="16,12,16,16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Export" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="EditedLengthText" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Length" />

                        <TextBlock Style="{StaticResource Label}" Text="Format" />
                        <RadioButton x:Name="Mp4Choice" GroupName="Format" Content="MP4 video" IsChecked="True" Checked="Format_Checked" />
                        <RadioButton x:Name="GifChoice" GroupName="Format" Content="GIF animation (no sound)" Checked="Format_Checked" />

                        <StackPanel x:Name="Mp4Options">
                            <TextBlock Style="{StaticResource Label}" Text="Size" />
                            <ComboBox x:Name="Mp4Size" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel x:Name="GifOptions" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Label}" Text="Width" />
                            <ComboBox x:Name="GifWidth" HorizontalAlignment="Stretch" />
                            <TextBlock Style="{StaticResource Label}" Text="Smoothness" />
                            <ComboBox x:Name="GifRate" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="GifHint" Style="{StaticResource Hint}" Text="GIFs get large quickly; short clips work best." />
                        </StackPanel>

                        <ui:Button x:Name="ExportButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowExportUp24}" Content="Export" Margin="0,20,0,0"
                                   HorizontalAlignment="Stretch" IsEnabled="False" Click="Export_Click" />

                        <StackPanel x:Name="ExportProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="1" Height="4" />
                            <DockPanel Margin="0,8,0,0">
                                <ui:Button DockPanel.Dock="Right" Content="Cancel" Click="CancelExport_Click" />
                                <TextBlock x:Name="ExportProgressText" VerticalAlignment="Center" Text="Exporting..." />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="ExportResultPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock x:Name="ExportResultText" TextWrapping="Wrap" />
                            <StackPanel x:Name="ExportResultButtons" Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Click="OpenExport_Click" />
                                <ui:Button Content="Show in folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="ShowExport_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Playback -->
        <DockPanel Grid.Row="3" Margin="12,10,12,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button x:Name="PreviousFrameButton" Appearance="Transparent" Icon="{ui:SymbolIcon Previous24}" ToolTip="Previous frame (Left; Shift+Left goes back a second)" IsEnabled="False" Click="PreviousFrame_Click" />
                <ui:Button x:Name="PlayButton" Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" ToolTip="Play the edited video (Space)" IsEnabled="False" Margin="4,0" Click="Play_Click" />
                <ui:Button x:Name="NextFrameButton" Appearance="Transparent" Icon="{ui:SymbolIcon Next24}" ToolTip="Next frame (Right; Shift+Right goes on a second)" IsEnabled="False" Click="NextFrame_Click" />
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Segoe UI Variable Text, Segoe UI" Text="0:00.00 / 0:00.00" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Speed" />
                <ComboBox x:Name="SpeedChoice" Width="96" SelectionChanged="Speed_SelectionChanged" />
            </StackPanel>
        </DockPanel>

        <local:TrimTimeline x:Name="Timeline" Grid.Row="4" Margin="12,10,12,0" />

        <TextBlock Grid.Row="5" Margin="24,8,12,12" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                   Text="Drag across the timeline to select, then Delete cuts it out. Drag the handles at either end to trim. I and O mark the selection at the playhead." />
    </Grid>
</ui:FluentWindow>
