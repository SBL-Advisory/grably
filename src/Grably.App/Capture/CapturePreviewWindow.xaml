<Window
    x:Class="Grably.App.Capture.CapturePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Grably preview"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    SizeToContent="WidthAndHeight"
    MinWidth="0"
    MinHeight="0">
    <Border
        Margin="8"
        Padding="10"
        CornerRadius="10"
        BorderThickness="1"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Screenshot saved" />
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="4" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close" Click="Close_Click" />
            </Grid>
            <Border CornerRadius="6" ClipToBounds="True" Cursor="Hand" ToolTip="Click to edit, or drag into another app" MouseLeftButtonDown="Image_MouseDown" MouseMove="Image_MouseMove" MouseLeftButtonUp="Image_MouseUp">
                <Image x:Name="PreviewImage" MaxWidth="300" MaxHeight="190" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,6,0" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" />
                <ui:Button Margin="0,0,6,0" Content="Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="Folder_Click" />
                <ui:Button Appearance="Primary" Content="Edit" Icon="{ui:SymbolIcon Edit24}" Click="Edit_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
