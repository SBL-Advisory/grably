<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows integration: Win32 (via CsWin32), WinRT and Direct3D. No WPF dependency. -->
  <PropertyGroup>
    <TargetFramework>$(GrablyWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(GrablyMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>Grably.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Grably ships for 64-bit Windows; some Win32 structs (SHFILEOPSTRUCT) differ on 32-bit. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grably.Core\Grably.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grably.Tests" />
  </ItemGroup>

</Project>
