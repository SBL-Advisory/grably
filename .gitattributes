# Normalise text to LF in the repository; check out with the platform default.
* text=auto

# Windows-only scripts keep CRLF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Scripts that run on Linux (the ffmpeg build in Docker) keep LF everywhere.
*.sh text eol=lf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.mp4 binary
*.zip binary
